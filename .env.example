APP_ENV=development
# Optional explicit dotenv path. Process/CI variables override file values.
# ENV_FILE=deploy/production.env
HTTP_ADDR=127.0.0.1:8080
# Only set when this peer is a controlled proxy that overwrites/appends client IP.
TRUSTED_PROXY_CIDRS=
PUBLIC_URL=http://localhost:3000
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=paradise
MAIL_DIRECTORY=var/mail
# Redis user/profile/session cache. MySQL stays the source of truth; if Redis
# is unreachable the API logs a warning and runs database-only.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# Per-user cache TTL in minutes (default 10).
REDIS_USER_TTL_MINUTES=10
# Display name embedded in Web3 sign-in/link messages (Laravel APP_NAME).
APP_NAME=Laravel
# Metarang host used to check whether a wallet is already registered
# (Laravel Metarang_API). Empty disables the lookup: existing-wallet logins
# keep working, unknown wallets answer 502 until it is configured.
Metarang_API=
# Development-only membership fixtures created by cmd/seed-local.
# Real signatures/nonces remain mandatory. Rejected in staging/production.
METARANG_LOCAL_FIXTURES=

# Laravel-compatible signed URLs: literal app.key value (including base64:).
# Empty creates a persistent development key at var/app.key.
APP_KEY=
# Reuse a securely provisioned Laravel private key to preserve public-key identity.
OAUTH_PRIVATE_KEY_PATH=var/oauth-private.key
# Import source only; target is MYSQL_DATABASE. Prefer a read-only source account.
LARAVEL_MYSQL_DSN=
# file writes development notices locally; smtp sends through configured server.
MAIL_MAILER=file
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=accounts@example.com
MAIL_FROM_NAME=IRPSC
# tls (STARTTLS), ssl (implicit TLS), or none for local testing.
MAIL_ENCRYPTION=tls

APP_LOCALE=fa
APP_TIMEZONE=Asia/Tehran
# SMTP is queued by default; run cmd/worker. sync is development-only.
MAIL_QUEUE=async
# Default Passport lifetimes: calendar year. Optional positive Go durations.
OAUTH_ACCESS_TTL=
OAUTH_REFRESH_TTL=
OAUTH_PERSONAL_TTL=
SESSION_TTL=2h
REMEMBER_SESSION_TTL=9600h
# Enable only after importing source file sessions / remember-token digests.
# Supply the exact source APP_KEY and cookie names.
LARAVEL_SESSION_COOKIE=
LARAVEL_REMEMBER_COOKIE=

# Matches Laravel API default; Web3 (10) and verification (6) have separate budgets.
RATE_LIMIT_PER_MINUTE=60
