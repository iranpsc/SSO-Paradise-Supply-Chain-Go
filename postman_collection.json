              "host": ["{{baseUrl}}"],
              "path": ["healthz"]
            }
          },
          "response": [
            {
              "name": "Health Check",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/healthz",
                  "host": ["{{baseUrl}}"],
                  "path": ["healthz"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json; charset=utf-8" },
                { "key": "Cache-Control", "value": "no-store" }
