{
  "info": {
    "name": "SSO Paradise Supply Chain API",
    "description": "API collection for SSO Paradise Supply Chain Go application.\n\n**Auth:** Send `Authorization: Bearer <token>` header or use the `paradise_session` cookie.\n\n**Base URL:** `http://127.0.0.1:8080`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "origin",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.method !== 'GET' && pm.request.method !== 'HEAD') {",
          "    pm.request.headers.upsert({key: 'Origin', value: pm.collectionVariables.get('origin') || 'http://localhost:3000'});",
          "}"
        ]
      }
    }
  ],
  "item": [
