{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/iranpsc/SSO-Paradise-Supply-Chain-Go.git",
  "tagFormat": "v${version}",
  "gitNotes": false,
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
