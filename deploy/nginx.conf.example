# TLS terminates at your existing reverse proxy. Replace the hostname and paths.
server {
    listen 443 ssl;
    server_name sso.example.com;
    ssl_certificate /etc/ssl/sso/fullchain.pem;
    ssl_certificate_key /etc/ssl/sso/private.key;
    client_max_body_size 4m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
server {
    listen 80;
    server_name sso.example.com;
    return 301 https://$host$request_uri;
}
