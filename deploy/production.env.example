# Copy to deploy/production.env; do not commit populated secrets.
APP_ENV=production
APP_NAME=Laravel
APP_LOCALE=fa
APP_TIMEZONE=Asia/Tehran
PUBLIC_URL=https://sso.example.com
APP_KEY=base64:REPLACE_WITH_EXACT_LARAVEL_APP_KEY
MYSQL_DATABASE=paradise_go
MYSQL_USER=sso
MYSQL_PASSWORD=REPLACE_WITH_TARGET_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SEPARATE_ADMIN_PASSWORD
MAIL_MAILER=smtp
MAIL_QUEUE=async
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_FROM_ADDRESS=accounts@example.com
MAIL_FROM_NAME=IRPSC
MAIL_ENCRYPTION=tls
REDIS_DB=0
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# Defaults to warning in production/staging; debug in development.
LOG_LEVEL=warning
# Optional source cookie bridge, after file sessions/remember tokens import.
LARAVEL_SESSION_COOKIE=laravel_session
LARAVEL_REMEMBER_COOKIE=
# Only for a controlled proxy that safely sets forwarded IP headers.
TRUSTED_PROXY_CIDRS=172.30.42.0/24
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=REPLACE_WITH_YOUR_PUBLIC_PROJECT_ID
